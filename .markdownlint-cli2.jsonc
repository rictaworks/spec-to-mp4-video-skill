{
  // Markdown の構文検査設定。
  // 日本語の文章とこのリポジトリの表記に合わないスタイル規則のみ無効化する。
  "config": {
    "MD013": false, // 行長制限。日本語は1行の文字数と表示幅が一致しないため適用しない
    "MD033": false, // インライン HTML。mermaid の <br/> を使うため許可する
    "MD060": false, // 表のパイプ前後の空白スタイル。既存の表記に合わせる
    "MD024": {
      "siblings_only": true // 同一階層でなければ見出しの重複を許可する
    }
  },
  "globs": [
    "**/*.md"
  ],
  "ignores": [
    "node_modules/**",
    "DELETE/**"
  ]
}
